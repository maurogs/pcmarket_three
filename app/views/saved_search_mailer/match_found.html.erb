<% content_for :title, t(".subject", count: 1, name: @listing.title.truncate(60)) %>
<p><%= t(".greeting", name: @user.display_name) %></p>
<p><%= t(".intro") %></p>
<p>
  <strong><%= @listing.title %></strong><br>
  <%= money(@listing.price_cents, @listing.currency) %>
</p>
<p>
  <%= link_to t(".view_listing"), listing_url(@listing, locale: @user.locale),
        style: "display:inline-block;background:#4f46e5;color:#fff;padding:0.6rem 1rem;border-radius:6px;" %>
</p>
<p><%= t(".manage", link: link_to(t(".manage_link"), saved_searches_url(locale: @user.locale))) %></p>
