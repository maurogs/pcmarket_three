<% content_for :title, t(".title") %>

<h1 class="text-2xl font-bold text-text"><%= t(".title") %></h1>

<%= render "tabs" %>

<% if @conversations.any? %>
  <div class="space-y-2">
    <%= turbo_stream_from current_user, :inbox %>
    <% @conversations.each do |conversation| %>
      <%= render "conversations/row", conversation: conversation,
          viewer: current_user, unread: @unread_counts.fetch(conversation.id, 0) %>
    <% end %>
  </div>
<% else %>
  <div class="card flex flex-col items-center gap-3 p-10 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h4m5 4H7a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3Z" />
    </svg>
    <p class="font-semibold text-text"><%= t(".empty.title") %></p>
    <p class="max-w-sm text-sm text-muted"><%= t(".empty.body") %></p>
    <%= link_to t(".empty.browse"), listings_path, class: "btn-primary" %>
  </div>
<% end %>
