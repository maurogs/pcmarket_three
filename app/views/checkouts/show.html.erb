<% set_meta(title: t(".title"), noindex: true) %>
<% currency = "EUR" %>

<div class="mx-auto max-w-2xl">
  <h1 class="text-xl font-bold tracking-tight sm:text-2xl"><%= t(".title") %></h1>

  <%= form_with url: checkout_path, method: :post, class: "mt-6 space-y-4" do |form| %>
    <%= hidden_field_tag :checkout_token, @checkout_token %>

    <%# --- step 1: shipping address ------------------------------------- %>
    <section class="card px-4 py-3">
      <h2 class="text-sm font-semibold text-text"><%= t(".address_section") %></h2>

      <% if @addresses.any? %>
        <div class="mt-3 space-y-2">
          <% @addresses.each do |address| %>
            <label class="flex cursor-pointer items-start gap-3 rounded-md border border-border px-3 py-2.5 has-checked:border-primary has-checked:bg-primary/5">
              <%= radio_button_tag :address_id, address.id, address.default?, class: "mt-1" %>
              <span class="min-w-0 text-sm">
                <span class="block font-medium text-text">
                  <%= address.full_name %>
                  <% if address.default? %><span class="ml-1 text-xs text-muted">(<%= t(".default_badge") %>)</span><% end %>
                </span>
                <span class="mt-0.5 block text-xs text-muted">
                  <%= [ address.line1, address.line2 ].compact_blank.join(", ") %><br>
                  <%= [ address.postal_code, address.city ].compact_blank.join(" – ") %><br>
                  <%= [ address.region, t("countries.#{address.country_code.downcase}") ].compact_blank.join(", ") %>
                </span>
              </span>
            </label>
          <% end %>
        </div>
        <p class="mt-3">
          <%= link_to t(".manage_addresses"), addresses_path(from: "checkout"), class: "text-sm font-medium text-primary hover:underline" %>
        </p>
      <% else %>
        <p class="mt-3 text-sm text-muted"><%= t(".no_address") %></p>
        <p class="mt-2">
          <%= link_to t(".add_address"), new_address_path(from: "checkout"), class: "btn-primary" %>
        </p>
      <% end %>
    </section>

    <%# --- step 2: shipping option per seller ---------------------------- %>
    <section class="card px-4 py-3">
      <h2 class="text-sm font-semibold text-text"><%= t(".delivery_section") %></h2>
      <div class="mt-3 space-y-4">
        <% @summary.groups.each do |group| %>
          <% next unless group.any_live? %>
          <div>
            <p class="text-sm font-medium text-text"><%= group.store&.name || group.seller.display_name %></p>
            <div class="mt-2 flex flex-wrap gap-2">
              <label class="flex cursor-pointer items-center gap-2 rounded-md border border-border px-3 py-2 text-sm has-checked:border-primary has-checked:bg-primary/5">
                <%= radio_button_tag "ship[#{group.seller.id}]", "delivery", true %>
                <span><%= t(".option_ship") %> —
                  <%= group.shipping_cents.zero? ? t(".shipping_free") : money(group.shipping_cents, currency) %></span>
              </label>
              <% if group.pickup_available? %>
                <label class="flex cursor-pointer items-center gap-2 rounded-md border border-border px-3 py-2 text-sm has-checked:border-primary has-checked:bg-primary/5">
                  <%= check_box_tag "pickup[#{group.seller.id}]", "1", false %>
                  <span><%= t(".option_pickup") %> — <%= t(".shipping_free") %></span>
                </label>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <%# --- step 3: payment ----------------------------------------------- %>
    <section class="card px-4 py-3">
      <h2 class="text-sm font-semibold text-text"><%= t(".payment_section") %></h2>
      <% if @stripe_mode %>
        <p class="mt-2 text-sm text-muted"><%= t(".card_hint") %></p>
        <%= form.submit t(".pay_card"), class: "btn-primary mt-3 w-full cursor-pointer" %>
      <% else %>
        <p class="mt-2 text-sm text-muted"><%= t(".direct_hint") %></p>
        <%= form.submit t(".pay_direct"), class: "btn-primary mt-3 w-full cursor-pointer" %>
      <% end %>
      <p class="mt-3 flex items-center gap-1.5 text-xs text-muted">
        <%= inline_icon :lock, classes: "size-3.5" %> <%= t(".secure_note") %>
      </p>
      <p class="mt-1.5 text-xs leading-5 text-muted">
        <%= t(".trust_hint") %>
        <%= link_to t(".trust_link"), trust_path, class: "text-primary underline hover:no-underline" %>
      </p>
    </section>

    <%# --- summary ------------------------------------------------------- %>
    <section class="card px-4 py-3">
      <h2 class="text-sm font-semibold text-text"><%= t(".summary_section") %></h2>
      <dl class="mt-3 space-y-1.5 text-sm">
        <div class="flex justify-between">
          <dt class="text-muted"><%= t(".subtotal") %></dt>
          <dd class="text-text"><%= money(@summary.subtotal_cents, currency) %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-muted"><%= t(".shipping") %></dt>
          <dd class="text-text"><%= money(@summary.shipping_cents, currency) %></dd>
        </div>
        <% commission = @summary.groups.sum { |g| CommissionCalculator.new(total_cents: g.subtotal_cents).call } %>
        <% if commission.positive? %>
          <div class="flex justify-between">
            <dt class="text-muted"><%= t(".commission") %></dt>
            <dd class="text-text"><%= money(commission, currency) %></dd>
          </div>
        <% end %>
        <div class="flex justify-between font-semibold text-text">
          <dt><%= t(".total") %></dt>
          <dd><%= money(@summary.total_cents + commission, currency) %></dd>
        </div>
      </dl>
    </section>
  <% end %>

  <p class="mt-4">
    <%= link_to t(".back_to_cart"), cart_path, class: "text-sm font-medium text-primary hover:underline" %>
  </p>
</div>
