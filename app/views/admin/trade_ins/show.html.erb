<%# Trade-in detail: quote facts + the allowed next state transitions. %>
<% quote = @trade_in %>
<% model_display = TradeIns::Quote.model_entry(quote.component_type, quote.model)&.fetch("display") %>

<h1 class="text-xl font-semibold"><%= model_display || quote.model %></h1>
<p class="mb-4 mt-1 text-sm text-muted">
  <%= link_to t(".back"), admin_trade_ins_path, class: "text-primary hover:underline" %>
</p>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
  <div class="rounded-lg border border-border bg-surface p-5">
    <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-muted"><%= TradeIn.human_attribute_name(:component_type) %></dt>
        <dd class="mt-1 text-sm font-medium"><%= TradeIn.human_attribute_name("component_type/#{quote.component_type}") %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-muted"><%= TradeIn.human_attribute_name(:model) %></dt>
        <dd class="mt-1 text-sm font-medium"><%= quote.model %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-muted"><%= TradeIn.human_attribute_name(:condition) %></dt>
        <dd class="mt-1 text-sm font-medium"><%= quote.class.human_attribute_name("condition/#{quote.condition}") %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-muted"><%= TradeIn.human_attribute_name(:has_box) %></dt>
        <dd class="mt-1 text-sm font-medium"><%= quote.has_box? ? t(".yes") : t(".no") %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-muted"><%= TradeIn.human_attribute_name(:offered_cents) %></dt>
        <dd class="mt-1 text-lg font-bold"><%= money(quote.offered_cents, "EUR") %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-muted"><%= TradeIn.human_attribute_name(:user) %></dt>
        <dd class="mt-1 text-sm font-medium">
          <% if quote.user %>
            <%= link_to quote.user.display_name, admin_user_path(quote.user), class: "text-primary hover:underline" %>
          <% else %>
            <%= t(".anonymous") %>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-muted"><%= TradeIn.human_attribute_name(:created_at) %></dt>
        <dd class="mt-1 text-sm text-muted"><%= l(quote.created_at, format: :long) %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-muted"><%= TradeIn.human_attribute_name(:expires_at) %></dt>
        <dd class="mt-1 text-sm text-muted"><%= l(quote.expires_at, format: :long) %></dd>
      </div>
    </dl>
  </div>

  <div class="rounded-lg border border-border bg-surface p-5">
    <h2 class="text-sm font-semibold"><%= t(".status_title") %></h2>
    <p class="mt-2">
      <span class="rounded-full bg-surface-muted px-2.5 py-1 text-xs font-semibold">
        <%= TradeIn.human_attribute_name("status/#{quote.status}") %>
      </span>
    </p>

    <% allowed = TradeIn::TRANSITIONS.fetch(quote.status, []) %>
    <% if allowed.any? %>
      <div class="mt-4 space-y-2">
        <% allowed.each do |next_status| %>
          <%= button_to t(".transitions.#{next_status}"), admin_trade_in_path(quote),
                method: :patch, params: { transition: next_status },
                class: "w-full cursor-pointer rounded-md border px-3 py-2 text-sm font-semibold " \
                       "#{next_status == "rejected" ? "border-accent/50 text-accent hover:bg-accent/10" : "border-primary/50 text-primary hover:bg-primary/10"}" %>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-sm text-muted"><%= t(".terminal") %></p>
    <% end %>
  </div>
</div>
