<% content_for :title, t(".title", name: @user.display_name) %>

<div class="mx-auto max-w-lg">
  <%= link_to t(".back"), admin_user_path(@user), class: "text-sm font-medium text-muted hover:text-primary hover:underline" %>
  <h1 class="mt-2 text-xl font-bold"><%= t(".title", name: @user.display_name) %></h1>

  <div class="mt-4 rounded-md border border-rose-200 bg-rose-50 p-4 text-sm text-rose-900 dark:border-rose-800 dark:bg-rose-950 dark:text-rose-200" role="alert">
    <%= t(".warning") %>
  </div>

  <%= form_with url: admin_user_ban_path(@user), method: :post do |form| %>
    <div class="card mt-4 p-4">
      <%= form.label :ban_reason, t(".reason_label"), class: "block text-sm font-semibold" %>
      <%= form.text_area :ban_reason, rows: 4, maxlength: 500,
            class: "input mt-1 w-full", placeholder: t(".reason_placeholder") %>
      <p class="mt-1 text-xs text-muted"><%= t(".reason_hint") %></p>
    </div>

    <div class="mt-4 flex items-center gap-2">
      <%= form.submit t(".submit"), class: "btn-danger" %>
      <%= link_to t(".cancel"), admin_user_path(@user), class: "btn-secondary" %>
    </div>
  <% end %>
</div>
