<% content_for :title, t(".title") %>

<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="text-xl font-bold"><%= t(".title") %></h1>
    <p class="mt-1 text-sm text-muted"><%= t(".subtitle", count: @pagy.count) %></p>
  </div>
  <%= link_to t(".new"), new_admin_legal_page_path, class: "btn-primary" %>
</div>

<form action="<%= admin_legal_pages_path %>" method="get" class="card mb-4 grid gap-3 p-3 sm:grid-cols-3">
  <%= select_tag :country,
        options_for_select(Country.order(:code).map { |c| [ "#{c.code} — #{c.display_name}", c.code ] }, params[:country]),
        include_blank: t(".filters.all_countries"), class: "input text-sm",
        aria: { label: t(".filters.country") } %>
  <%= select_tag :locale,
        options_for_select(I18n.available_locales.map { |l| [ t("locales.#{l}"), l.to_s ] }, params[:locale]),
        include_blank: t(".filters.all_locales"), class: "input text-sm",
        aria: { label: t(".filters.locale") } %>
  <div class="flex items-center gap-2">
    <button type="submit" class="btn-primary"><%= t(".filters.apply") %></button>
    <%= link_to t(".filters.clear"), admin_legal_pages_path, class: "btn-secondary" %>
  </div>
</form>

<% if @legal_pages.any? %>
  <div class="card overflow-x-auto">
    <table class="admin-table w-full min-w-[820px] text-sm">
      <thead>
        <tr>
          <th scope="col"><%= t(".columns.slug") %></th>
          <th scope="col"><%= t(".columns.title") %></th>
          <th scope="col"><%= t(".columns.country") %></th>
          <th scope="col"><%= t(".columns.locale") %></th>
          <th scope="col"><%= t(".columns.state") %></th>
          <th scope="col"><span class="sr-only"><%= t(".columns.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% @legal_pages.each do |page| %>
          <tr>
            <td class="font-mono text-xs"><%= page.slug %></td>
            <td class="max-w-[20rem] truncate"><%= page.title %></td>
            <td><%= page.country_code %></td>
            <td class="text-muted"><%= t("locales.#{page.locale}") %></td>
            <td>
              <% if page.published? %>
                <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-800"><%= t(".published_chip") %></span>
              <% else %>
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-600"><%= t(".draft_chip") %></span>
              <% end %>
            </td>
            <td class="whitespace-nowrap text-right">
              <%= link_to t(".actions.view"), admin_legal_page_path(page), class: "btn-secondary" %>
              <%= link_to t(".actions.edit"), edit_admin_legal_page_path(page), class: "btn-secondary" %>
              <%= link_to t(".actions.copy"),
                    new_admin_legal_page_path(country_code: page.country_code, slug: page.slug, copy_from: page.locale),
                    class: "btn-secondary" %>
              <%= button_to t(".actions.destroy"), admin_legal_page_path(page), method: :delete,
                    class: "btn-secondary text-red-600",
                    form: { data: { turbo_confirm: t(".actions.destroy_confirm") } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-4"><%= results_pagination(@pagy) %></div>
<% else %>
  <div class="card p-6 text-center text-sm text-muted"><%= t(".empty") %></div>
<% end %>
