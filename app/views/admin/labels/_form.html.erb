<%# locals: form (form builder), label %>
<% if label.errors.any? %>
  <div class="mb-4 rounded border border-red-300 bg-red-50 p-3 text-sm text-red-800">
    <ul class="list-inside list-disc">
      <% label.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="grid gap-4">
  <div>
    <%= form.label :color, class: "block text-sm font-medium" %>
    <div class="flex items-center gap-2">
      <%= form.color_field :color, class: "h-9 w-14 rounded border" %>
      <%= form.text_field :color, class: "input w-28 text-sm font-mono", placeholder: "#3b82f6" %>
    </div>
  </div>

  <%= render "admin/shared/translation_fields",
        name_base: "label[names]", values: label.names, multiline: false,
        label: t(".names_label") %>

  <div class="flex gap-2">
    <%= form.submit t(".submit"), class: "btn-primary" %>
    <%= link_to t(".cancel"), admin_labels_path, class: "btn-secondary" %>
  </div>
</div>
