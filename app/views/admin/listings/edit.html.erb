<% content_for :title, t(".title", title: @listing.title) %>

<div class="mx-auto max-w-3xl">
  <%= link_to t(".back"), admin_listing_path(@listing), class: "text-sm font-medium text-muted hover:text-primary hover:underline" %>
  <h1 class="mt-2 text-xl font-bold"><%= t(".title", title: @listing.title) %></h1>
  <p class="mb-4 mt-1 text-sm text-muted"><%= t(".subtitle") %></p>

  <%= form_with model: @listing, url: admin_listing_path(@listing), method: :patch do |form| %>
    <% if @listing.errors.any? %>
      <div class="mb-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300" role="alert">
        <ul class="list-inside list-disc">
          <% @listing.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="card space-y-4 p-4">
      <div>
        <%= form.label :title, class: "block text-sm font-medium" %>
        <%= form.text_field :title, class: "input mt-1 w-full", required: true %>
      </div>

      <div>
        <%= form.label :description, class: "block text-sm font-medium" %>
        <%= form.text_area :description, rows: 6, class: "input mt-1 w-full" %>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :status, class: "block text-sm font-medium" %>
          <%= form.select :status,
                Listing.statuses.keys.map { |s| [ Listing.human_attribute_name("status/#{s}"), s ] },
                {}, class: "input mt-1 w-full" %>
          <p class="mt-1 text-xs text-muted"><%= t(".status_hint") %></p>
        </div>
        <div>
          <%= form.label :category_id, class: "block text-sm font-medium" %>
          <%= form.select :category_id,
                Category.ordered.map { |c| [ c.name, c.id ] },
                { include_blank: true }, class: "input mt-1 w-full" %>
        </div>
        <div>
          <%= form.label :condition, class: "block text-sm font-medium" %>
          <%= form.select :condition,
                Listing.conditions.keys.map { |c| [ Listing.human_attribute_name("condition/#{c}"), c ] },
                {}, class: "input mt-1 w-full" %>
        </div>
        <div>
          <%= form.label :quantity, class: "block text-sm font-medium" %>
          <%= form.number_field :quantity, min: 1, class: "input mt-1 w-full" %>
        </div>
        <div>
          <%= form.label :price, class: "block text-sm font-medium" %>
          <%= number_field_tag "listing[price]", @listing.price_cents ? ("%.2f" % (BigDecimal(@listing.price_cents) / 100)) : nil,
                step: 0.01, min: 0.01, class: "input mt-1 w-full" %>
        </div>
        <div>
          <%= form.label :original_price, class: "block text-sm font-medium" %>
          <%= number_field_tag "listing[original_price]", @listing.original_price_cents&.nonzero? ? ("%.2f" % (BigDecimal(@listing.original_price_cents) / 100)) : nil,
                step: 0.01, min: 0.01, class: "input mt-1 w-full" %>
        </div>
        <div>
          <%= form.label :shipping_price, class: "block text-sm font-medium" %>
          <%= number_field_tag "listing[shipping_price]", @listing.shipping_price_cents&.nonzero? ? ("%.2f" % (BigDecimal(@listing.shipping_price_cents) / 100)) : nil,
                step: 0.01, min: 0.01, class: "input mt-1 w-full",
                placeholder: t(".free_shipping_placeholder") %>
        </div>
        <div>
          <%= form.label :featured_until, class: "block text-sm font-medium" %>
          <%= form.datetime_local_field :featured_until, class: "input mt-1 w-full" %>
        </div>
        <div>
          <%= form.label :city, class: "block text-sm font-medium" %>
          <%= form.text_field :city, class: "input mt-1 w-full" %>
        </div>
        <div>
          <%= form.label :region, class: "block text-sm font-medium" %>
          <%= form.text_field :region, class: "input mt-1 w-full" %>
        </div>
        <div>
          <%= form.label :postal_code, class: "block text-sm font-medium" %>
          <%= form.text_field :postal_code, class: "input mt-1 w-full" %>
        </div>
      </div>

      <div>
        <%= form.label :specs_json, t(".specs_label"), class: "block text-sm font-medium" %>
        <%= text_area_tag "listing[specs_json]", @listing.specs.present? ? JSON.pretty_generate(@listing.specs) : "",
              rows: 6, class: "input mt-1 w-full font-mono text-xs" %>
        <p class="mt-1 text-xs text-muted"><%= t(".specs_hint") %></p>
      </div>

      <fieldset>
        <legend class="text-sm font-medium"><%= Listing.human_attribute_name("labels") %></legend>
        <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
          <% Label.order(:id).each do |label| %>
            <label class="flex items-center gap-2 text-sm">
              <%= check_box_tag "listing[label_ids][]", label.id, @listing.label_ids.include?(label.id) %>
              <span><%= label.names.values.first %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
    </div>

    <div class="mt-4 flex items-center gap-2">
      <%= form.submit t(".submit"), class: "btn-primary" %>
      <%= link_to t(".cancel"), admin_listing_path(@listing), class: "btn-secondary" %>
    </div>
  <% end %>
</div>
