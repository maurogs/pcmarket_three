<% content_for :title, t(".title") %>

<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="text-xl font-bold"><%= t(".title") %></h1>
    <p class="mt-1 text-sm text-muted"><%= t(".subtitle") %></p>
  </div>
  <% if @report.open? %>
    <span class="chip bg-amber-100 text-amber-900 dark:bg-amber-500/20 dark:text-amber-200"><%= t(".states.open") %></span>
  <% else %>
    <span class="chip"><%= t(".states.#{@report.resolved_action}") %></span>
  <% end %>
</div>

<div class="grid gap-4 lg:grid-cols-3">
  <div class="space-y-4 lg:col-span-2">
    <section class="card p-4">
      <h2 class="mb-3 text-sm font-semibold text-muted"><%= t(".report_section") %></h2>
      <dl class="grid gap-2 text-sm sm:grid-cols-2">
        <div>
          <dt class="text-xs text-muted"><%= t(".columns.reason") %></dt>
          <dd><span class="chip"><%= t("admin.reports.index.reasons.#{@report.reason}") %></span></dd>
        </div>
        <div>
          <dt class="text-xs text-muted"><%= t(".columns.when") %></dt>
          <dd><%= l(@report.created_at, format: :long) %></dd>
        </div>
      </dl>
      <h3 class="mt-4 text-xs font-medium text-muted"><%= t(".details_label") %></h3>
      <p class="mt-1 whitespace-pre-line text-sm"><%= @report.details.presence || t(".no_details") %></p>

      <% unless @report.open? %>
        <p class="mt-4 rounded-md bg-surface-muted px-3 py-2 text-xs text-muted">
          <%= t(".closed_at", time: l(@report.resolved_at, format: :long), admin: @report.resolved_by&.display_name || "—") %>
        </p>
      <% end %>
    </section>

    <section class="card p-4">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-sm font-semibold text-muted"><%= t(".sibling_section", count: @sibling_reports.size) %></h2>
        <% open_count = @report.listing.reports.open.count %>
        <% if open_count >= Report::FLOOD_THRESHOLD && @report.listing.pending_review? %>
          <span class="chip bg-red-100 text-red-800 dark:bg-red-500/20 dark:text-red-200"><%= t(".requeued") %></span>
        <% end %>
      </div>
      <ul class="divide-y divide-border text-sm">
        <% @sibling_reports.each do |other| %>
          <li class="flex items-center justify-between gap-3 py-2">
            <div class="min-w-0">
              <% if other.id == @report.id %>
                <span class="font-medium"><%= t(".this_report") %></span>
              <% else %>
                <%= link_to t("admin.reports.index.reasons.#{other.reason}"), admin_report_path(other), class: "font-medium hover:text-primary" %>
              <% end %>
              <span class="block truncate text-xs text-muted"><%= other.user.display_name %> · <%= l(other.created_at, format: :long) %></span>
            </div>
            <% if other.open? %>
              <span class="chip"><%= t("admin.reports.index.states.open") %></span>
            <% else %>
              <span class="chip"><%= t("admin.reports.index.states.#{other.resolved_action}") %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  </div>

  <div class="space-y-4">
    <section class="card p-4">
      <h2 class="mb-3 text-sm font-semibold text-muted"><%= t(".listing_section") %></h2>
      <p class="text-sm font-medium"><%= @report.listing.title %></p>
      <p class="mt-1 text-xs text-muted"><%= @report.listing.slug %> · <%= Listing.human_attribute_name("status/#{@report.listing.status}") %></p>
      <div class="mt-3 flex flex-wrap gap-2">
        <%= link_to t(".view_listing"), admin_listing_path(@report.listing), class: "btn-secondary" %>
        <%= link_to t(".view_store_seller"), admin_user_path(@report.listing.user), class: "btn-secondary" %>
      </div>
    </section>

    <section class="card p-4">
      <h2 class="mb-1 text-sm font-semibold text-muted"><%= t(".reporter_section") %></h2>
      <p class="text-sm"><%= @report.user.display_name %></p>
      <p class="text-xs text-muted"><%= @report.user.email_address %></p>
      <%= link_to t(".view_reporter"), admin_user_path(@report.user), class: "btn-secondary mt-3" %>
    </section>

    <section class="card p-4">
      <h2 class="mb-3 text-sm font-semibold text-muted"><%= t(".close_section") %></h2>
      <% if @report.open? %>
        <div class="grid gap-2">
          <%= button_to t(".resolve"), admin_report_resolution_path(@report), class: "btn-primary" %>
          <%= button_to t(".dismiss"), admin_report_dismissal_path(@report), class: "btn-secondary" %>
          <p class="text-xs text-muted"><%= t(".close_hint") %></p>
        </div>
      <% else %>
        <p class="text-sm text-muted"><%= t(".already_closed") %></p>
      <% end %>
    </section>
  </div>
</div>

<p class="mt-4"><%= link_to t(".back"), admin_reports_path, class: "text-sm text-primary hover:underline" %></p>
