<%# locals: user, counts (status => count from Listing.status_counts) %>
<div class="card p-4">
  <div class="flex items-center justify-between gap-2">
    <h2 class="text-sm font-semibold text-muted"><%= t(".seller") %></h2>
    <%= link_to t(".view_profile"), admin_user_path(user), class: "text-xs font-medium text-primary hover:underline" %>
  </div>

  <p class="mt-2 font-medium">
    <%= link_to user.display_name, admin_user_path(user), class: "hover:text-primary hover:underline" %>
    <span class="text-sm text-muted">@<%= user.username %></span>
  </p>
  <p class="mt-0.5 text-xs text-muted">
    <%= t(".member_since", date: l(user.created_at.to_date, format: :delivery)) %>
    <% if user.banned? %>
      <span class="ml-2 rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-800"><%= t(".banned") %></span>
    <% end %>
  </p>

  <dl class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
    <% %w[approved pending_review rejected sold archived draft].each do |status| %>
      <% count = counts.fetch(status, 0) %>
      <% next if count.zero? %>
      <div class="flex items-center gap-1">
        <dt class="text-muted"><%= Listing.human_attribute_name("status/#{status}") %></dt>
        <dd class="font-semibold"><%= count %></dd>
      </div>
    <% end %>
  </dl>
</div>
