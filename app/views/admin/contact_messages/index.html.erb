<% content_for :title, t(".title") %>

<div class="mb-4">
  <h1 class="text-xl font-bold"><%= t(".title") %></h1>
  <p class="mt-1 text-sm text-muted"><%= t(".subtitle", count: @pagy.count) %></p>
</div>

<form action="<%= admin_contact_messages_path %>" method="get" class="card mb-4 flex flex-wrap items-center gap-2 p-3">
  <%= select_tag :lang,
        options_for_select(I18n.available_locales.map { |loc| [ t("locales.#{loc}"), loc.to_s ] }, params[:lang]),
        include_blank: t(".filters.all_locales"), class: "input text-sm sm:w-48",
        aria: { label: t(".filters.locale") } %>
  <div class="flex items-center gap-2">
    <button type="submit" class="btn-primary"><%= t(".filters.apply") %></button>
    <%= link_to t(".filters.clear"), admin_contact_messages_path, class: "btn-secondary" %>
  </div>
</form>

<% if @messages.any? %>
  <div class="card overflow-x-auto">
    <table class="admin-table w-full min-w-[760px] text-sm">
      <thead>
        <tr>
          <th scope="col"><%= t(".columns.from") %></th>
          <th scope="col"><%= t(".columns.subject") %></th>
          <th scope="col"><%= t(".columns.locale") %></th>
          <th scope="col"><%= t(".columns.when") %></th>
        </tr>
      </thead>
      <tbody>
        <% @messages.each do |message| %>
          <tr>
            <td>
              <%= link_to admin_contact_message_path(message), class: "font-medium text-text hover:text-primary" do %>
                <%= message.name %>
              <% end %>
              <span class="block truncate text-xs text-muted"><%= message.email %></span>
            </td>
            <td class="max-w-[24rem]"><span class="line-clamp-1"><%= message.subject %></span></td>
            <td><span class="chip"><%= t("locales.#{message.locale}") %></span></td>
            <td class="whitespace-nowrap text-muted"><%= l(message.created_at, format: :long) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-4"><%= results_pagination(@pagy) %></div>
<% else %>
  <div class="card p-6 text-center text-sm text-muted"><%= t(".empty") %></div>
<% end %>
