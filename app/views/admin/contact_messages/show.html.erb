<% content_for :title, t(".title") %>

<div class="mb-4">
  <h1 class="text-xl font-bold"><%= t(".title") %></h1>
  <p class="mt-1 text-sm text-muted"><%= t(".subtitle", time: l(@message.created_at, format: :long)) %></p>
</div>

<div class="grid gap-4 lg:grid-cols-3">
  <section class="card p-4 lg:col-span-2">
    <h2 class="mb-3 text-sm font-semibold text-muted"><%= t(".body_section") %></h2>
    <dl class="mb-4 grid gap-2 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-xs text-muted"><%= t(".columns.from") %></dt>
        <dd>
          <%= @message.name %>
          <span class="block"><%= mail_to @message.email, @message.email, class: "text-primary hover:underline" %></span>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-muted"><%= t(".columns.subject") %></dt>
        <dd><%= @message.subject %></dd>
      </div>
    </dl>
    <p class="whitespace-pre-line text-sm leading-6"><%= @message.body %></p>
  </section>

  <section class="card h-fit p-4">
    <h2 class="mb-3 text-sm font-semibold text-muted"><%= t(".meta_section") %></h2>
    <dl class="grid gap-2 text-sm">
      <div>
        <dt class="text-xs text-muted"><%= t(".columns.locale") %></dt>
        <dd><%= t("locales.#{@message.locale}") %></dd>
      </div>
      <div>
        <dt class="text-xs text-muted"><%= t(".columns.when") %></dt>
        <dd><%= l(@message.created_at, format: :long) %></dd>
      </div>
    </dl>
    <p class="mt-3 text-xs text-muted"><%= t(".support_note") %></p>
  </section>
</div>

<p class="mt-4"><%= link_to t(".back"), admin_contact_messages_path, class: "text-sm text-primary hover:underline" %></p>
