<% content_for :title, t(".title") %>

<h1 class="text-2xl font-bold text-text"><%= t(".title") %></h1>

<%= render "conversations/tabs" %>

<% if @blocks.any? %>
  <div class="space-y-2">
    <% @blocks.each do |block| %>
      <div class="card flex items-center gap-3 p-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface-muted text-sm font-bold text-text">
          <%= user_initials(block.blocked) %>
        </div>
        <div class="min-w-0 flex-1">
          <p class="truncate font-semibold text-text"><%= block.blocked.display_name %></p>
          <p class="text-xs text-muted"><%= l block.created_at, format: :chat_day %></p>
        </div>
        <%= button_to t(".unblock"), block_path(block), method: :delete, class: "chip shrink-0 cursor-pointer" %>
      </div>
    <% end %>
  </div>
  <div class="mt-6"><%= results_pagination(@pagy) %></div>
<% else %>
  <div class="card p-10 text-center">
    <p class="font-semibold text-text"><%= t(".empty") %></p>
    <p class="mt-1 text-sm text-muted"><%= t(".empty_hint") %></p>
  </div>
<% end %>
