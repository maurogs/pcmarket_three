<% offer = message.offer %>
<div class="rounded-xl border border-border bg-surface p-3">
  <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-300">
    <%= t(".title") %>
  </p>
  <p class="mt-1 text-lg font-bold text-text">
    <%= money(offer.amount_cents, offer.listing.currency) %>
  </p>
  <p class="mt-1 text-xs text-muted">
    <%= Offer.human_attribute_name("status/#{offer.status}") %>
    <span aria-hidden="true">&middot;</span>
    <%= t(".expires", time: l(offer.expires_at, format: :chat_day)) %>
  </p>
</div>
