<% set_meta(title: t("legal_pages.slugs.#{@page.slug}"), description: t("seo.legal.description")) %>

<div class="mx-auto max-w-5xl">
  <header>
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl"><%= t("legal_pages.slugs.#{@page.slug}") %></h1>
    <p class="mt-2 text-xs text-muted">
      <%= t(".updated_at", date: l(@page.updated_at.to_date, format: :long)) %>
      · <span class="uppercase"><%= @page.locale %></span>
    </p>
  </header>

  <% if @fallback_locale %>
    <p class="mt-4 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-xs leading-5 text-amber-900 dark:border-amber-500/40 dark:bg-amber-500/10 dark:text-amber-200">
      <%= t(".fallback_notice", locale_name: t("locales.#{@fallback_locale}")) %>
      <%= link_to t(".fallback_link"), legal_page_path(@page.slug, locale: @fallback_locale),
                  class: "font-medium underline hover:no-underline" %>
    </p>
  <% end %>

  <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_220px]">
    <article class="prose-market min-w-0">
      <%= @rendered.body_html %>
    </article>

    <% if @rendered.toc.any? %>
      <nav aria-label="<%= t(".toc_title") %>" class="hidden lg:block">
        <div class="sticky top-20">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-muted"><%= t(".toc_title") %></h2>
          <ul class="mt-3 space-y-2 text-xs">
            <% @rendered.toc.each do |entry| %>
              <li><a href="#<%= entry[:id] %>" class="text-muted hover:text-primary hover:underline"><%= entry[:label] %></a></li>
            <% end %>
          </ul>
        </div>
      </nav>
    <% end %>
  </div>

  <% if Setting.legal_identity_complete? %>
    <section class="mt-10 card p-5">
      <h2 class="text-sm font-semibold"><%= t(".company.title") %></h2>
      <dl class="mt-3 grid gap-x-6 gap-y-3 text-xs sm:grid-cols-2">
        <% %w[legal_name trade_name tax_id registered_address registry contact_email dpo_email phone].each do |key| %>
          <% value = @identity[key].to_s %>
          <% next if value.blank? %>
          <div>
            <dt class="font-medium text-text"><%= t(".company.#{key}") %></dt>
            <dd class="mt-0.5 text-muted">
              <% if key == "contact_email" || key == "dpo_email" %>
                <%= mail_to value %>
              <% elsif key == "phone" %>
                <%= phone_to value %>
              <% else %>
                <%= value %>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
    </section>
  <% end %>

  <p class="mt-8 text-xs text-muted">
    <%= link_to t(".back"), root_path, class: "text-primary underline hover:no-underline" %>
  </p>
</div>
