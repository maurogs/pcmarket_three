<div class="mx-auto w-full max-w-md">
  <h1 class="text-3xl font-bold"><%= t(".title") %></h1>

  <% if @user.errors.any? %>
    <div class="mt-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300" role="alert">
      <ul class="list-inside list-disc space-y-1">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path, method: :post, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, class: "block text-sm font-medium text-text" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", class: "mt-2 w-full rounded-md border border-border bg-surface px-3 py-2 text-text focus:border-primary focus:outline-none" %>
    </div>

    <div>
      <%= form.label :username, class: "block text-sm font-medium text-text" %>
      <%= form.text_field :username, required: true, autocomplete: "username", pattern: "[a-zA-Z0-9_\\-]{3,30}", title: t(".username_hint"), class: "mt-2 w-full rounded-md border border-border bg-surface px-3 py-2 text-text focus:border-primary focus:outline-none" %>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :first_name, class: "block text-sm font-medium text-text" %>
        <%= form.text_field :first_name, autocomplete: "given-name", class: "mt-2 w-full rounded-md border border-border bg-surface px-3 py-2 text-text focus:border-primary focus:outline-none" %>
      </div>
      <div>
        <%= form.label :last_name, class: "block text-sm font-medium text-text" %>
        <%= form.text_field :last_name, autocomplete: "family-name", class: "mt-2 w-full rounded-md border border-border bg-surface px-3 py-2 text-text focus:border-primary focus:outline-none" %>
      </div>
    </div>

    <div>
      <%= form.label :phone, class: "block text-sm font-medium text-text" %>
      <%= form.telephone_field :phone, autocomplete: "tel", placeholder: t(".phone_hint"), class: "mt-2 w-full rounded-md border border-border bg-surface px-3 py-2 text-text placeholder:text-muted focus:border-primary focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password, class: "block text-sm font-medium text-text" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 w-full rounded-md border border-border bg-surface px-3 py-2 text-text focus:border-primary focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password_confirmation, class: "block text-sm font-medium text-text" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 w-full rounded-md border border-border bg-surface px-3 py-2 text-text focus:border-primary focus:outline-none" %>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <%= form.submit t(".submit"), class: "rounded-md bg-primary px-4 py-2.5 font-medium text-white hover:bg-primary/90 cursor-pointer" %>
      <p class="text-sm text-muted">
        <%= t(".already_have_account") %>
        <%= link_to t("nav.log_in"), new_session_path, class: "font-medium text-primary underline hover:no-underline" %>
      </p>
    </div>
  <% end %>
</div>
