<% content_for :title, t(".title", number: @sale.number) %>

<div class="mx-auto max-w-2xl">
  <div class="mb-4 flex flex-wrap items-center gap-3">
    <h1 class="min-w-0 flex-1 text-xl font-bold tracking-tight sm:text-2xl">
      <%= t(".title", number: @sale.number) %>
    </h1>
    <%= order_status_badge(@sale) %>
  </div>
  <p class="mb-4"><%= link_to t(".back"), sell_sales_path, class: "text-sm font-medium text-primary hover:underline" %></p>

  <div class="card px-4 py-3">
    <dl class="grid grid-cols-1 gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
      <div class="flex justify-between gap-3 sm:justify-start">
        <dt class="shrink-0 text-muted"><%= t(".placed_on") %></dt>
        <dd class="text-text"><%= l(@sale.created_at, format: :long) %></dd>
      </div>
      <div class="flex justify-between gap-3 sm:justify-start">
        <dt class="shrink-0 text-muted"><%= t(".buyer") %></dt>
        <dd class="text-text"><%= @sale.buyer.display_name %></dd>
      </div>
      <% if @sale.tracking_number.present? %>
        <div class="flex justify-between gap-3 sm:justify-start">
          <dt class="shrink-0 text-muted"><%= t(".tracking") %></dt>
          <dd class="text-text"><%= @sale.tracking_number %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <h2 class="mt-6 text-lg font-semibold text-text"><%= t(".items") %></h2>
  <ul class="card mt-2 divide-y divide-border">
    <% @sale.order_items.each do |item| %>
      <li class="flex items-center gap-3 px-4 py-3">
        <div class="min-w-0 flex-1">
          <% if item.listing %>
            <%= link_to item.title, listing_path(item.listing), class: "text-sm font-medium text-text hover:text-primary hover:underline" %>
          <% else %>
            <span class="text-sm font-medium text-text"><%= item.title %></span>
          <% end %>
          <p class="mt-0.5 text-xs text-muted"><%= t(".quantity", count: item.quantity) %></p>
        </div>
        <p class="text-sm font-semibold text-text"><%= money(item.line_total_cents, @sale.currency) %></p>
      </li>
    <% end %>
  </ul>

  <h2 class="mt-6 text-lg font-semibold text-text"><%= t(".totals") %></h2>
  <dl class="card mt-2 divide-y divide-border text-sm">
    <div class="flex justify-between px-4 py-2.5">
      <dt class="text-muted"><%= t(".subtotal") %></dt>
      <dd class="text-text"><%= money(@sale.subtotal_cents, @sale.currency) %></dd>
    </div>
    <div class="flex justify-between px-4 py-2.5">
      <dt class="text-muted"><%= t(".shipping") %></dt>
      <dd class="text-text"><%= @sale.shipping_cents.zero? ? t(".free_shipping") : money(@sale.shipping_cents, @sale.currency) %></dd>
    </div>
    <div class="flex justify-between px-4 py-2.5">
      <dt class="text-muted"><%= t(".commission") %></dt>
      <dd class="text-text"><%= money(@sale.commission_cents, @sale.currency) %></dd>
    </div>
    <div class="flex justify-between px-4 py-2.5 font-semibold text-text">
      <dt><%= t(".total") %></dt>
      <dd><%= money(@sale.total_cents, @sale.currency) %></dd>
    </div>
    <div class="flex justify-between bg-emerald-50 px-4 py-2.5 font-semibold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
      <dt><%= t(".net_revenue") %></dt>
      <dd><%= money(@sale.net_revenue_cents, @sale.currency) %></dd>
    </div>
  </dl>

  <%# --- fulfilment actions (sellers only, guarded by order state) -------- %>
  <% sale_conversation = @sale.conversation %>
  <% if @sale.pending_payment? || @sale.paid? || sale_conversation %>
    <div class="card mt-6 px-4 py-3">
      <h2 class="text-sm font-semibold text-text"><%= t(".actions_title") %></h2>

      <% if @sale.pending_payment? %>
        <p class="mt-2 text-xs text-muted">
          <%= @sale.payment_provider == "stripe" ? t(".stripe_pending_hint") : t(".direct_pending_hint") %>
        </p>
        <% if @sale.payment_provider != "stripe" %>
          <%= button_to t(".confirm_payment_button"), sell_sale_payment_confirmation_path(@sale), method: :post,
                class: "btn-primary mt-3 cursor-pointer" %>
        <% end %>
      <% end %>

      <% if @sale.paid? %>
        <%= form_with url: sell_sale_shipment_path(@sale), method: :post, class: "mt-3 space-y-3" do |form| %>
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <%= form.label :carrier, t(".carrier_label"), class: "block text-sm font-medium text-text" %>
              <%= form.select :carrier, carrier_options_for_select,
                    { selected: Order::CARRIERS.first }, class: "input mt-1" %>
            </div>
            <div>
              <%= form.label :tracking_number, t(".tracking_label"), class: "block text-sm font-medium text-text" %>
              <%= form.text_field :tracking_number, class: "input mt-1" %>
            </div>
          </div>
          <%= form.submit t(".ship_button"), class: "btn-primary cursor-pointer" %>
        <% end %>
      <% end %>

      <div class="mt-3 flex flex-wrap gap-2">
        <% if sale_conversation %>
          <%= link_to t(".contact_buyer"), conversation_path(sale_conversation), class: "chip" %>
        <% end %>
        <%= button_to t(".cancel_order_button"), sell_sale_cancellation_path(@sale), method: :post, class: "chip",
              form: { data: { turbo_confirm: t(".cancel_confirm") } } %>
      </div>
      <p class="mt-2 text-xs text-muted"><%= t(".cancel_note") %></p>
    </div>
  <% end %>

  <%# --- progress ---------------------------------------------------------- %>
  <div class="card mt-6 px-4 py-3">
    <h2 class="mb-3 text-sm font-semibold text-text"><%= t(".progress") %></h2>
    <%= render "orders/timeline", order: @sale %>
  </div>
</div>
