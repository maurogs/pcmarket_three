<% content_for :title, t(".title") %>

<div class="mb-4 flex items-center gap-3">
  <h1 class="min-w-0 flex-1 text-xl font-bold tracking-tight sm:text-2xl"><%= t(".title") %></h1>
</div>

<% if @sales.any? %>
  <ul class="card mt-4 divide-y divide-border">
    <% @sales.each do |order| %>
      <li>
        <%= link_to sell_sale_path(order), class: "flex flex-wrap items-center gap-x-4 gap-y-1.5 px-4 py-3 hover:bg-surface-muted" do %>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-sm font-semibold text-text"><%= order.number %></span>
              <%= order_status_badge(order) %>
            </div>
            <p class="mt-1 truncate text-xs text-muted">
              <% first, *rest = order.order_items %>
              <%= first&.title %>
              <% if rest.any? %>
                <%= t(".more_items", count: rest.size) %>
              <% end %>
            </p>
            <p class="mt-0.5 text-xs text-muted"><%= l(order.created_at.to_date, format: :long) %></p>
          </div>

          <div class="text-right">
            <p class="text-sm font-semibold text-text"><%= money(order.total_cents, order.currency) %></p>
            <p class="text-[11px] text-muted"><%= t(".net", amount: money(order.net_revenue_cents, order.currency)) %></p>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>

  <div class="mt-4"><%= results_pagination @pagy %></div>
<% else %>
  <div class="card mt-4 px-6 py-10 text-center">
    <p class="text-sm font-medium text-text"><%= t(".empty.title") %></p>
    <p class="mt-1 text-xs text-muted"><%= t(".empty.hint") %></p>
    <%= link_to t(".empty.cta"), sell_listings_path,
          class: "mt-4 inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-semibold text-white hover:bg-primary-hover" %>
  </div>
<% end %>
