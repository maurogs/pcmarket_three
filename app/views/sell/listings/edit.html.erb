<header class="mb-4">
  <h1 class="text-xl font-bold tracking-tight sm:text-2xl"><%= t(".title") %></h1>
  <div class="mt-2 flex flex-wrap items-center gap-3">
    <span class="<%= status_badge_class(@listing.status) %>"><%= Listing.human_attribute_name("status/#{@listing.status}") %></span>
    <span class="text-sm text-muted"><%= t(".updated_at", time: time_ago_in_words(@listing.updated_at)) %></span>
  </div>
  <% if @listing.rejected? && @listing.rejection_reason.present? %>
    <p class="mt-3 max-w-2xl rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300">
      <strong class="font-semibold"><%= Listing.human_attribute_name(:rejection_reason) %>:</strong>
      <%= @listing.rejection_reason %>
    </p>
  <% end %>
  <% if @listing.approved? %>
    <p class="mt-3 max-w-2xl text-sm text-muted"><%= t(".live_edit_warning") %></p>
  <% end %>
</header>

<%= render "form" %>
