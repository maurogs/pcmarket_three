<%# Turbo Frame #results: count, applied-filter chips, sort, grid, pagination.
    Only this partial is re-rendered when a filter changes. %>
<div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
  <p class="text-sm text-muted">
    <span class="font-semibold text-text"><%= number_with_delimiter(@result.total_count) %></span>
    <%= t(".count", count: @result.total_count) %>
  </p>

  <div class="ml-auto flex items-center gap-2">
    <%# Mobile-only: opens the same sidebar as a bottom sheet. %>
    <button type="button" data-action="filters#open"
            class="inline-flex min-h-11 items-center gap-1.5 rounded-md border border-border px-3 text-sm font-medium hover:border-primary hover:text-primary lg:hidden">
      <%= inline_icon :filter, classes: "size-4" %>
      <%= t(".filters_button") %>
    </button>

    <label class="flex items-center gap-2 text-sm text-muted">
      <span class="hidden sm:inline"><%= t(".sort") %></span>
      <%= select_tag :sort,
            options_for_select(ListingSearch::SORTS.map { |s| [ t(".sort_options.#{s}"), s] },
                               @result.filters[:sort]),
            "data-action": "filters#submit",
            aria: { label: t(".sort") },
            class: "h-11 min-w-36 rounded-md border border-border bg-surface px-2 text-sm font-medium text-text focus:border-primary focus:outline-none" %>
    </label>
  </div>
</div>

<%# --- applied filter chips ------------------------------------------------ %>
<% chips = applied_filter_chips(@result) %>
<% if chips.any? %>
  <ul class="mb-4 flex flex-wrap gap-2" aria-label="<%= t(".applied_filters") %>">
    <% chips.each do |label, href| %>
      <li>
        <%= link_to href, class: "inline-flex min-h-9 items-center gap-1.5 rounded-full bg-surface-muted px-3 text-xs font-medium text-text hover:bg-primary hover:text-white",
              rel: "nofollow" do %>
          <span class="truncate"><%= label %></span>
          <span aria-hidden="true" class="text-muted group-hover:text-white">&times;</span>
          <span class="sr-only"><%= t(".remove_filter") %></span>
        <% end %>
      </li>
    <% end %>
    <li><%= link_to t(".clear_all"), request.path, class: "inline-flex min-h-9 items-center px-1 text-xs font-semibold text-primary hover:underline" %></li>
  </ul>

  <%# Save the current filter set as an email-alert-ready saved search. Sits
      inside the results frame (re-rendered on every filter change), outside
      the sidebar GET form, so it can be its own POST form. %>
  <% if authenticated? && @result.applied_filters? %>
    <%= form_with url: saved_searches_path, method: :post,
          data: { turbo_frame: "_top" },
          class: "mb-4 flex flex-wrap items-center gap-2 rounded-lg border border-border bg-surface-muted px-3 py-2" do |form| %>
      <% %i[q min_price max_price condition].each do |key| %>
        <%= hidden_field_tag key, @result.filters[key] if @result.filters[key].present? %>
      <% end %>
      <% if @result.filters[:category].present? %>
        <% cat = @result.filters[:category] %>
        <%= hidden_field_tag :category, cat.respond_to?(:slug) ? cat.slug : cat %>
      <% end %>
      <% if @result.filters[:seller].present? %>
        <% seller = @result.filters[:seller] %>
        <%= hidden_field_tag :seller, seller.respond_to?(:slug) ? seller.slug : seller %>
      <% end %>
      <% Array(@result.filters[:f]).each do |value| %>
        <%= hidden_field_tag "f[]", value %>
      <% end %>
      <% Array(@result.filters[:labels]).each do |value| %>
        <%= hidden_field_tag "labels[]", value %>
      <% end %>

      <span class="flex items-center gap-1.5 text-sm font-medium">
        <%= inline_icon :bookmark, classes: "size-4 text-primary" %>
        <%= t(".save_search.label") %>
      </span>
      <%= form.text_field :name, required: true, maxlength: 120,
            placeholder: t(".save_search.name_placeholder"), aria: { label: t(".save_search.name_placeholder") },
            class: "h-9 min-w-0 flex-1 basis-40 rounded-md border border-border bg-surface px-2.5 text-sm focus:border-primary focus:outline-none" %>
      <%= form.submit t(".save_search.submit"), class: "min-h-9 cursor-pointer rounded-md bg-primary px-3 text-sm font-semibold text-white hover:bg-primary-hover" %>
    <% end %>
  <% end %>
<% end %>

<% if @result.empty? %>
  <div class="rounded-lg border border-dashed border-border bg-surface-muted px-4 py-10 text-center">
    <h2 class="text-base font-semibold"><%= t(".empty_title") %></h2>
    <p class="mx-auto mt-1 max-w-md text-sm text-muted"><%= t(".empty_text") %></p>

    <% if @result.applied_filters? %>
      <%= link_to t(".clear_all"), request.path,
            class: "mt-4 inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-semibold text-white hover:bg-primary-hover" %>
    <% else %>
      <nav aria-label="<%= t(".empty_categories") %>" class="mt-4">
        <ul class="flex flex-wrap justify-center gap-2">
          <% Category.roots.active.ordered.limit(8).each do |root| %>
            <li><%= link_to root.name, category_path(root),
                  class: "inline-flex min-h-11 items-center rounded-full border border-border bg-surface px-3.5 text-sm font-medium hover:border-primary hover:text-primary" %></li>
          <% end %>
        </ul>
      </nav>
    <% end %>
  </div>
<% else %>
  <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 xl:grid-cols-4">
    <% @result.records.each do |listing| %>
      <li><%= render "shared/listing_card", listing: listing %></li>
    <% end %>
  </ul>

  <% if @result.pagy.pages > 1 %>
    <nav class="mt-8 flex justify-center">
      <%= results_pagination(@result.pagy) %>
    </nav>
  <% end %>
<% end %>
