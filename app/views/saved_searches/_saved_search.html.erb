<%# One saved-search row. Turbo Stream targets (update/destroy) address this id. %>
<li id="saved_search_<%= saved_search.id %>"
    class="flex flex-wrap items-center gap-x-3 gap-y-2 rounded-xl border border-border bg-surface p-4 shadow-sm">
  <div class="min-w-0 flex-1">
    <%= link_to saved_search.name, listings_path(**saved_search.search_params.transform_keys(&:to_sym)),
          class: "text-sm font-semibold hover:text-primary hover:underline" %>
    <p class="mt-0.5 truncate text-xs text-muted"><%= saved_search_filters_summary(saved_search) %></p>
  </div>

  <% if saved_search.email_alerts? %>
    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-medium text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
      <%= inline_icon :bell, classes: "size-3.5" %>
      <%= t(".alerts_on") %>
    </span>
  <% else %>
    <span class="inline-flex items-center gap-1.5 rounded-full bg-surface-muted px-2.5 py-1 text-xs font-medium text-muted">
      <%= inline_icon :bell, classes: "size-3.5" %>
      <%= t(".alerts_off") %>
    </span>
  <% end %>

  <%= button_to t(saved_search.email_alerts? ? ".alerts_disable" : ".alerts_enable"),
        saved_search_path(saved_search), method: :patch,
        class: "cursor-pointer rounded-md border border-border px-2.5 py-1.5 text-xs font-medium hover:border-primary hover:text-primary" %>

  <%= button_to saved_search_path(saved_search), method: :delete,
        class: "inline-flex cursor-pointer items-center gap-1 rounded-md px-2 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950",
        title: t(".delete"), aria: { label: t(".delete") } do %>
    <%= inline_icon :close, classes: "size-3.5" %>
    <%= t(".delete") %>
  <% end %>
</li>
