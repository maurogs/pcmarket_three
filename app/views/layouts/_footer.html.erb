<footer class="mt-12 border-t border-border bg-surface-muted">
  <div class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-8 px-4 py-10 md:grid-cols-4">
    <div>
      <h2 class="text-sm font-semibold text-text"><%= t("footer.newsletter_title") %></h2>
      <form class="mt-3 flex gap-2" action="#" method="get">
        <input type="email" name="newsletter_email" required placeholder="<%= t("footer.newsletter_placeholder") %>" class="w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text placeholder:text-muted focus:border-primary focus:outline-none" aria-label="<%= t("footer.newsletter_placeholder") %>">
        <input type="submit" value="<%= t("footer.newsletter_submit") %>" class="rounded-md bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary/90 cursor-pointer">
      </form>
    </div>

    <% [
         [ "footer.about", %w[footer.about_us footer.careers footer.press] ],
         [ "footer.help", %w[footer.contact footer.faq footer.shipping] ],
         [ "footer.buying_selling", %w[footer.how_to_sell footer.how_to_buy footer.selling_requirements] ]
       ].each do |heading_key, link_keys| %>
      <nav aria-label="<%= t(heading_key) %>">
        <h2 class="text-sm font-semibold text-text"><%= t(heading_key) %></h2>
        <ul class="mt-3 space-y-2 text-sm">
          <% link_keys.each do |key| %>
            <li><%= link_to t(key), "#", class: "text-muted hover:text-text" %></li>
          <% end %>
        </ul>
      </nav>
    <% end %>
  </div>

  <div class="border-t border-border">
    <div class="mx-auto flex w-full max-w-6xl flex-col items-center justify-between gap-3 px-4 py-4 text-sm md:flex-row">
      <div class="flex items-center gap-2">
        <span class="text-muted"><%= t("footer.language") %>:</span>
        <% I18n.available_locales.each do |locale| %>
          <% if locale.to_s == I18n.locale.to_s %>
            <span class="font-medium text-primary" aria-current="true"><%= t("locales.#{locale}") %></span>
          <% else %>
            <%= link_to t("locales.#{locale}"), url_for(locale: locale), class: "text-muted hover:text-text" %>
          <% end %>
        <% end %>
      </div>
      <p class="text-muted"><%= t("footer.copyright", year: Date.current.year, brand: t("site.name")) %></p>
    </div>
  </div>
</footer>
