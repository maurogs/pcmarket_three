<% footer_values = Setting.get_many(Setting::FOOTER_KEYS) %>
<% social = footer_values["social_links"] || {} %>
<% legal_links = LegalPage.deliverable_slugs(country_code: current_country_code, locale: I18n.locale.to_s) %>
<% blog_url = footer_values["blog_url"].to_s %>
<% support_email = footer_values["support_email"].to_s %>
<% support_phone = footer_values["support_phone"].to_s %>
<% identity = Setting.legal_identity(footer_values) %>
<% company = (identity["legal_name"].presence || identity["trade_name"].presence || t("site.name")).to_s %>

<footer class="mt-12 border-t border-border bg-surface-muted" data-controller="cookie-consent"
        data-cookie-consent-version-value="<%= cookie_consent_version %>">
  <div class="mx-auto grid w-full max-w-6xl grid-cols-2 gap-8 px-4 py-10 sm:grid-cols-3 lg:grid-cols-5">
    <nav aria-label="<%= t("footer.about") %>" class="col-span-2 sm:col-span-3 lg:col-span-1">
      <h2 class="text-sm font-semibold text-text"><%= t("footer.about") %></h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><%= link_to t("footer.about_us"), page_path("about"), class: "text-muted hover:text-text" %></li>
        <li><%= link_to t("footer.trust_safety"), trust_path, class: "text-muted hover:text-text" %></li>
        <% if blog_url.present? %>
          <li><%= link_to t("footer.blog"), blog_url, target: "_blank", rel: "noopener", class: "text-muted hover:text-text" %></li>
        <% end %>
      </ul>
    </nav>

    <nav aria-label="<%= t("footer.help") %>">
      <h2 class="text-sm font-semibold text-text"><%= t("footer.help") %></h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><%= link_to t("footer.help_centre"), page_path("help"), class: "text-muted hover:text-text" %></li>
        <li><%= link_to t("footer.contact"), page_path("contact"), class: "text-muted hover:text-text" %></li>
        <% if support_email.present? %>
          <li><%= mail_to support_email, support_email, class: "text-muted hover:text-text" %></li>
        <% end %>
        <% if support_phone.present? %>
          <li><%= phone_to support_phone, support_phone, class: "text-muted hover:text-text" %></li>
        <% end %>
      </ul>
    </nav>

    <nav aria-label="<%= t("footer.buying_selling") %>">
      <h2 class="text-sm font-semibold text-text"><%= t("footer.buying_selling") %></h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><%= link_to t("footer.how_it_works"), page_path("how-it-works"), class: "text-muted hover:text-text" %></li>
        <li><%= link_to t("footer.sell_on"), page_path("selling"), class: "text-muted hover:text-text" %></li>
        <li><%= link_to t("footer.seller_guides"), page_path("seller-guides"), class: "text-muted hover:text-text" %></li>
        <li><%= link_to t("footer.pc_finder"), pc_finder_path, class: "text-muted hover:text-text" %></li>
        <% if Flipper.enabled?(:sell_to_us) %>
          <li><%= link_to t("footer.sell_to_us"), new_trade_in_quote_path, class: "text-muted hover:text-text" %></li>
        <% end %>
      </ul>
    </nav>

    <nav aria-label="<%= t("footer.legal") %>">
      <h2 class="text-sm font-semibold text-text"><%= t("footer.legal") %></h2>
      <ul class="mt-3 space-y-2 text-sm">
        <% %w[terms privacy cookies returns buyer_protection].each do |slug| %>
          <% next unless legal_links.key?(slug) %>
          <li><%= link_to t("legal_pages.slugs.#{slug}"), legal_page_path(slug), class: "text-muted hover:text-text" %></li>
        <% end %>
        <li>
          <button type="button" data-action="cookie-consent#openPreferences"
                  class="text-muted hover:text-text"><%= t("footer.cookie_preferences") %></button>
        </li>
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold text-text"><%= t("footer.follow_us") %></h2>
      <% links = Admin::Settings::SOCIAL_SITES.filter_map { |site| [site, social[site]] if social[site].present? } %>
      <% if links.any? %>
        <ul class="mt-3 flex flex-wrap gap-3 text-sm">
          <% links.each do |site, url| %>
            <li><%= link_to t("footer.social.#{site}"), url, target: "_blank", rel: "noopener nofollow", class: "text-muted hover:text-text" %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-xs leading-5 text-muted"><%= t("footer.no_social") %></p>
      <% end %>
      <p class="mt-4 text-xs leading-5 text-muted"><%= t("footer.country_indicator", country: t("countries.#{current_country_code.downcase}")) %></p>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="mx-auto flex w-full max-w-6xl flex-col items-center justify-between gap-3 px-4 py-4 text-sm md:flex-row">
      <div class="flex flex-wrap items-center justify-center gap-2">
        <span class="text-muted"><%= t("footer.language") %>:</span>
        <% I18n.available_locales.each do |locale| %>
          <% if locale.to_s == I18n.locale.to_s %>
            <span class="font-medium text-primary" aria-current="true"><%= t("locales.#{locale}") %></span>
          <% else %>
            <%= link_to t("locales.#{locale}"), url_for(locale: locale), class: "text-muted hover:text-text" %>
          <% end %>
        <% end %>
      </div>
      <p class="text-muted"><%= t("footer.copyright", year: Date.current.year, brand: company) %></p>
    </div>
  </div>

  <%= render "shared/cookie_consent" %>
</footer>
