<% content_for :title, t(".title") %>

<h1 class="text-2xl font-bold"><%= t(".title") %></h1>
<p class="mt-1 text-sm text-muted"><%= t(".description") %></p>

<%= form_with model: current_user, url: account_notification_preferences_path, method: :patch,
      class: "card mt-6 space-y-5 px-4 py-4" do |form| %>
  <% %w[email_new_message email_offers email_orders email_price_drop email_saved_search email_newsletter].each do |key| %>
    <label class="flex cursor-pointer items-start gap-3">
      <%= form.check_box key, class: "mt-1 size-4 rounded border-border accent-primary" %>
      <span>
        <span class="block text-sm font-medium text-text"><%= t(".topics.#{key}.label") %></span>
        <span class="block text-xs text-muted"><%= t(".topics.#{key}.hint") %></span>
      </span>
    </label>
  <% end %>

  <p class="border-t border-border pt-4 text-xs text-muted"><%= t(".in_app_note") %></p>

  <%= form.submit t(".save"), class: "btn-primary cursor-pointer" %>
<% end %>
