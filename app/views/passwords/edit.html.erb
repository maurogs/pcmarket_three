<div class="mx-auto w-full max-w-md">
  <h1 class="text-3xl font-bold"><%= t(".title") %></h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :password, class: "block text-sm font-medium text-text" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: t(".password_placeholder"), maxlength: 72, class: "mt-2 w-full rounded-md border border-border bg-surface px-3 py-2 text-text placeholder:text-muted focus:border-primary focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password_confirmation, class: "block text-sm font-medium text-text" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: t(".password_confirmation_placeholder"), maxlength: 72, class: "mt-2 w-full rounded-md border border-border bg-surface px-3 py-2 text-text placeholder:text-muted focus:border-primary focus:outline-none" %>
    </div>

    <%= form.submit t(".submit"), class: "rounded-md bg-primary px-4 py-2.5 font-medium text-white hover:bg-primary/90 cursor-pointer" %>
  <% end %>
</div>
