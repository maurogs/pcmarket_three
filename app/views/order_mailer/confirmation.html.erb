<% content_for :title, t(".subject", number: @order.number) %>
<p><%= t(".greeting", name: @recipient.display_name) %></p>
<p><%= t(".intro", number: @order.number) %></p>
<ul>
  <% @order.order_items.each do |item| %>
    <li><%= item.title %> × <%= item.quantity %> — <%= money(item.line_total_cents, @order.currency) %></li>
  <% end %>
</ul>
<p><%= t(".total", amount: money(@order.total_cents, @order.currency)) %></p>
<p>
  <%= link_to t(".view_order"), order_url(@order, locale: @recipient.locale),
        style: "display:inline-block;background:#4f46e5;color:#fff;padding:0.6rem 1rem;border-radius:6px;" %>
</p>
<p><%= t(".safety") %></p>
