<% set_meta(title: t(".title"), noindex: true) %>
<div class="mx-auto w-full max-w-md">
  <h1 class="text-3xl font-bold"><%= t(".title") %></h1>

  <%= form_with url: session_url, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, class: "block text-sm font-medium text-text" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: t("activerecord.attributes.user.email_address"), value: params[:email_address], class: "mt-2 w-full rounded-md border border-border bg-surface px-3 py-2 text-text placeholder:text-muted focus:border-primary focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password, class: "block text-sm font-medium text-text" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "mt-2 w-full rounded-md border border-border bg-surface px-3 py-2 text-text focus:border-primary focus:outline-none" %>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <%= form.submit t(".submit"), class: "rounded-md bg-primary px-4 py-2.5 font-medium text-white hover:bg-primary/90 cursor-pointer" %>
      <%= link_to t(".forgot_password"), new_password_path, class: "text-sm text-muted underline hover:no-underline hover:text-text" %>
    </div>
  <% end %>

  <p class="mt-6 text-sm text-muted">
    <%= t(".no_account") %>
    <%= link_to t("nav.sign_up"), new_registration_path, class: "font-medium text-primary underline hover:no-underline" %>
  </p>
</div>
