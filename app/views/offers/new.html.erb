<% content_for :title, t(".title") %>

<div class="mx-auto max-w-lg">
  <div class="card p-5">
    <h1 class="text-xl font-bold text-text"><%= t(".title") %></h1>

    <div class="mt-3 flex items-center gap-3 border-b border-border pb-3">
      <div class="min-w-0 flex-1">
        <p class="truncate font-medium text-text"><%= @listing.title %></p>
        <p class="text-sm text-muted">
          <%= t(".asking_price", price: money(@listing.price_cents, @listing.currency)) %>
        </p>
      </div>
    </div>

    <% if @error %>
      <p class="mt-3 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:bg-rose-950 dark:text-rose-300" role="alert">
        <%= @error %>
      </p>
    <% end %>

    <%= form_with url: listing_offers_path(@listing), method: :post, class: "mt-4 space-y-3" do |form| %>
      <div>
        <%= form.label :amount, t(".amount_label"), class: "block text-sm font-medium text-text" %>
        <div class="relative mt-1">
          <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-muted">&euro;</span>
          <%= form.text_field :amount, name: "offer[amount]",
              class: "input pl-7", inputmode: "decimal", autocomplete: "off",
              placeholder: format("%d", @listing.price_cents / 100), required: true %>
        </div>
        <p class="mt-1 text-xs text-muted">
          <%= t(".minimum_hint", min: money(Offers::Create.minimum_for(@listing), @listing.currency)) %>
        </p>
      </div>

      <div class="flex justify-end gap-2">
        <%= link_to t(".cancel"), listing_path(@listing), class: "chip" %>
        <%= form.submit t(".submit"), class: "btn-primary cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
