<%# PC Finder entry points (phase 7a): vibe filters, budget rail and a
    "best PCs for <game>" strip that pre-fills the quiz results. %>
<% cache [ I18n.locale, "home/finder", Listing.maximum(:updated_at) ], expires_in: 20.minutes do %>
  <% vibe_tags = SellerTag.where(slug: %w[minimalist anime competitive]).order(:slug).to_a %>
  <% under_budget = Listing.published.in_finder_categories
                          .where(price_cents: ...100_000).with_card_data
                          .order(price_cents: :asc, id: :desc).limit(12).to_a %>
  <% best_games = Performance::FpsEstimator.games.first(6) %>

  <% if vibe_tags.any? || under_budget.any? %>
    <section class="mx-auto max-w-6xl px-4 py-8" aria-labelledby="finder-heading">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 id="finder-heading" class="text-lg font-semibold sm:text-xl"><%= t(".title") %></h2>
        <%= link_to t(".cta"), pc_finder_path,
              class: "inline-flex min-h-11 items-center gap-1.5 rounded-md border border-primary/40 px-4 text-sm font-semibold text-primary hover:bg-primary hover:text-white" %>
      </div>

      <% if vibe_tags.any? %>
        <h3 class="mt-5 text-sm font-semibold text-muted"><%= t(".vibe_title") %></h3>
        <ul class="mt-2 flex flex-wrap gap-2">
          <% vibe_tags.each do |tag| %>
            <li>
              <%= link_to tag.name, pc_finder_results_path(tags: tag.slug),
                    class: "inline-flex min-h-11 items-center rounded-full border border-border bg-surface px-4 text-sm font-medium hover:border-primary hover:text-primary" %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if under_budget.any? %>
        <h3 class="mt-6 text-sm font-semibold text-muted"><%= t(".under_budget_title") %></h3>
        <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 xl:grid-cols-4">
          <% under_budget.first(4).each do |listing| %>
            <li><%= render "shared/listing_card", listing: listing %></li>
          <% end %>
        </ul>
        <%= link_to t(".under_budget_more"), pc_finder_results_path(budget: "under_700", fps: "60"),
              class: "mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-primary hover:underline" %>
      <% end %>

      <h3 class="mt-6 text-sm font-semibold text-muted"><%= t(".best_for_title") %></h3>
      <ul class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
        <% best_games.each do |game| %>
          <li>
            <%= link_to pc_finder_results_path(games: game[:slug], resolution: "1080p", fps: "60"),
                  class: "flex min-h-11 items-center justify-center rounded-lg border border-border bg-surface px-3 py-2 text-center text-xs font-semibold hover:border-primary hover:text-primary" do %>
              <%= game[:name] %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
