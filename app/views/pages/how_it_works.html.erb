<% set_meta(title: t(".title"), description: t(".lede")) %>
<% escrow = Flipper.enabled?(:stripe_checkout) %>

<div class="mx-auto max-w-3xl">
  <h1 class="text-2xl font-bold tracking-tight sm:text-3xl"><%= t(".title") %></h1>
  <p class="mt-3 text-sm leading-6 text-muted sm:text-base"><%= t(".lede") %></p>

  <section class="mt-8">
    <h2 class="text-lg font-semibold"><%= t(".search.title") %></h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <% %w[filter series pc_finder].each do |item| %>
        <div class="card p-4">
          <h3 class="text-sm font-semibold"><%= t(".search.#{item}.title") %></h3>
          <p class="mt-1 text-xs leading-5 text-muted"><%= t(".search.#{item}.text") %></p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-semibold"><%= t(".buy.title") %></h2>
    <ol class="mt-4 space-y-4">
      <% %w[reserve pay receive].each_with_index do |step, i| %>
        <li class="card flex gap-4 p-4">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary"><%= i + 1 %></span>
          <div>
            <h3 class="text-sm font-semibold"><%= t(".buy.#{step}.title") %></h3>
            <p class="mt-1 text-xs leading-5 text-muted"><%= t(".buy.#{step}.text") %></p>
          </div>
        </li>
      <% end %>
    </ol>
    <p class="mt-3 text-xs leading-5 text-muted"><%= t(escrow ? ".buy.escrow_note" : ".buy.direct_note") %></p>
    <p class="mt-2 text-xs leading-5 text-muted">
      <%= link_to t(".buy.trust_link"), trust_path, class: "text-primary underline hover:no-underline" %>
    </p>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-semibold"><%= t(".pay.title") %></h2>
    <ul class="mt-4 grid gap-2.5 sm:grid-cols-3">
      <% %w[methods hold receipt].each do |item| %>
        <li class="card flex items-start gap-3 p-4 text-sm">
          <span class="mt-0.5 text-green-600 dark:text-green-400"><%= inline_icon :check, classes: "size-5" %></span>
          <span><%= t(".pay.items.#{item}") %></span>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-semibold"><%= t(".more.title") %></h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <% { "tracking" => orders_path, "trust" => trust_path, "help" => page_path("help") }.each do |key, path| %>
        <%= link_to path, class: "card block p-4 hover:border-primary" do %>
          <h3 class="text-sm font-semibold"><%= t(".more.#{key}.title") %></h3>
          <p class="mt-1 text-xs leading-5 text-muted"><%= t(".more.#{key}.text") %></p>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="mt-10 rounded-lg bg-primary px-6 py-8 text-center text-white">
    <h2 class="text-lg font-semibold"><%= t(".cta.title") %></h2>
    <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
      <%= link_to t(".cta.browse"), listings_path, class: "rounded-md bg-white px-4 py-2 text-sm font-medium text-primary hover:bg-white/90" %>
      <% if authenticated? %>
        <%= link_to t(".cta.sell"), new_sell_listing_path, class: "rounded-md border border-white/40 px-4 py-2 text-sm font-medium text-white hover:bg-white/10" %>
      <% else %>
        <%= link_to t(".cta.sell"), new_registration_path, class: "rounded-md border border-white/40 px-4 py-2 text-sm font-medium text-white hover:bg-white/10" %>
      <% end %>
    </div>
  </section>
</div>
