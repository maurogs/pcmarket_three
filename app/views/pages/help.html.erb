<% content_for :title, t(".title") %>

<div class="mx-auto max-w-3xl" data-controller="faq-filter">
  <h1 class="text-2xl font-bold tracking-tight sm:text-3xl"><%= t(".title") %></h1>
  <p class="mt-3 text-sm leading-6 text-muted sm:text-base"><%= t(".lede") %></p>

  <label class="sr-only" for="faq_filter"><%= t(".search_label") %></label>
  <input id="faq_filter" type="search" placeholder="<%= t(".search_placeholder") %>" autocomplete="off"
         class="input mt-6 w-full" data-faq-filter-target="input" data-action="input->faq-filter#filter">
  <p hidden class="mt-2 text-xs text-muted" data-faq-filter-target="empty"><%= t(".no_results") %></p>

  <div class="mt-6 space-y-8">
    <% %w[buying selling payments shipping account].each do |group| %>
      <section data-faq-filter-target="section">
        <h2 class="text-lg font-semibold"><%= t(".groups.#{group}") %></h2>
        <div class="mt-3 space-y-2">
          <% (1..3).each do |n| %>
            <details class="card group p-0 [&_summary::-webkit-details-marker]:hidden"
                     data-faq-filter-target="item"
                     data-keywords="<%= t("pages.help.faq.#{group}.q#{n}") + " " + t("pages.help.faq.#{group}.a#{n}") %>">
              <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-3 px-4 py-3 text-sm font-medium">
                <%= t(".faq.#{group}.q#{n}") %>
                <span class="text-muted transition group-open:rotate-180" aria-hidden="true">
                  <%= inline_icon :chevron_down, classes: "size-4" %>
                </span>
              </summary>
              <p class="border-t border-border px-4 py-3 text-sm leading-6 text-muted"><%= t(".faq.#{group}.a#{n}") %></p>
            </details>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <section class="mt-10">
    <div class="card flex flex-wrap items-center justify-between gap-4 p-5">
      <div>
        <h2 class="text-sm font-semibold"><%= t(".still_lost.title") %></h2>
        <p class="mt-1 text-xs text-muted"><%= t(".still_lost.text") %></p>
      </div>
      <%= link_to t(".still_lost.cta"), page_path("contact"), class: "btn-primary text-sm" %>
    </div>
  </section>
</div>
