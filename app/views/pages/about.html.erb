<% set_meta(title: t(".title"), description: t(".lede")) %>

<div class="mx-auto max-w-3xl">
  <h1 class="text-2xl font-bold tracking-tight sm:text-3xl"><%= t(".title") %></h1>
  <p class="mt-3 text-sm leading-6 text-muted sm:text-base"><%= t(".lede") %></p>

  <div class="mt-8 grid gap-3 sm:grid-cols-3">
    <% %w[mission wide fair].each_with_index do |card, i| %>
      <div class="card p-4">
        <span class="flex size-8 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary"><%= i + 1 %></span>
        <h2 class="mt-3 text-sm font-semibold"><%= t(".cards.#{card}.title") %></h2>
        <p class="mt-1 text-xs leading-5 text-muted"><%= t(".cards.#{card}.text") %></p>
      </div>
    <% end %>
  </div>

  <section class="mt-8">
    <h2 class="text-lg font-semibold"><%= t(".story.title") %></h2>
    <div class="mt-3 space-y-3 text-sm leading-6 text-muted">
      <p><%= t(".story.p1") %></p>
      <p><%= t(".story.p2") %></p>
    </div>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-semibold"><%= t(".values.title") %></h2>
    <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
      <% %w[a b c d].each do |item| %>
        <li class="card flex items-start gap-3 p-4 text-sm">
          <span class="mt-0.5 text-green-600 dark:text-green-400"><%= inline_icon :check, classes: "size-5" %></span>
          <span><%= t(".values.items.#{item}") %></span>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-semibold"><%= t(".promise.title") %></h2>
    <p class="mt-3 max-w-2xl text-sm leading-6 text-muted"><%= t(".promise.text") %></p>
    <div class="mt-5 flex flex-wrap gap-3">
      <%= link_to t(".promise.trust_cta"), trust_path, class: "btn-primary text-sm" %>
      <%= link_to t(".promise.contact_cta"), page_path("contact"), class: "btn-secondary text-sm" %>
    </div>
  </section>
</div>
