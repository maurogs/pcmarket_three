<% store = @store %>
<% set_meta_tags(title: store.name, description: store.description.to_s.truncate(160)) %>

<header class="overflow-hidden rounded-lg border border-border bg-surface">
  <div class="h-28 bg-gradient-to-r from-primary/80 via-primary to-accent sm:h-36">
    <% if store.banner.attached? %>
      <%= image_tag store_banner_url(store, :display), alt: "", class: "size-full object-cover",
            loading: "lazy", decoding: "async", width: 1600, height: 400 %>
    <% end %>
  </div>

  <div class="flex flex-wrap items-end gap-4 p-4">
    <div class="-mt-10 flex size-20 shrink-0 items-center justify-center rounded-lg border border-border bg-surface text-xl font-bold text-primary sm:size-24 sm:text-2xl">
      <% if store.logo.attached? %>
        <%= image_tag store_logo_url(store, :card), alt: "", class: "size-full rounded-lg object-cover",
              loading: "lazy", decoding: "async", width: 400, height: 400 %>
      <% else %>
        <%= store.name[0, 2].upcase %>
      <% end %>
    </div>

    <div class="min-w-0 flex-1">
      <h1 class="flex flex-wrap items-center gap-2 text-xl font-bold sm:text-2xl">
        <span class="truncate"><%= store.name %></span>
        <%= verified_badge(store, classes: "size-5") %>
      </h1>

      <p class="mt-1 text-xs text-muted">
        <% if store.reviews_count.positive? %>
          <span class="inline-flex items-center gap-1.5 align-middle">
            <%= stars(store.rating_average) %>
            <span class="font-medium text-text"><%= number_with_precision(store.rating_average, precision: 1) %></span>
            <span>· <%= t(".reviews_count", count: store.reviews_count) %></span>
          </span>
        <% else %>
          <%= t(".no_reviews") %>
        <% end %>
      </p>
    </div>

    <div class="flex gap-2">
      <%= render "shared/follow_button", store: store %>
      <button type="button" disabled title="<%= t(".message_soon") %>"
              class="inline-flex min-h-11 cursor-not-allowed items-center rounded-md border border-border px-4 text-sm font-semibold text-muted">
        <%= t(".message") %>
      </button>
    </div>
  </div>

  <dl class="grid grid-cols-3 divide-x divide-border border-t border-border text-center">
    <div class="px-2 py-3">
      <dt class="text-xs text-muted"><%= t(".stats_followers") %></dt>
      <dd class="text-sm font-bold tabular-nums"><%= render "follower_count", store: store %></dd>
    </div>
    <div class="px-2 py-3">
      <dt class="text-xs text-muted"><%= t(".stats_for_sale") %></dt>
      <dd class="text-sm font-bold tabular-nums">
        <%= number_with_delimiter(@tab == "listings" ? @result.total_count : store.listings_count) %>
      </dd>
    </div>
    <div class="px-2 py-3">
      <dt class="text-xs text-muted"><%= t(".stats_sold") %></dt>
      <dd class="text-sm font-bold tabular-nums"><%= number_with_delimiter(store.sales_count) %></dd>
    </div>
  </dl>
</header>

<%# Vacation mode: the store keeps selling nothing while away, but the
    catalogue stays browsable (ListingSearch does not exclude it). %>
<% if store.vacation_mode? %>
  <p class="mt-4 flex items-center gap-2 rounded-md border border-border bg-surface-muted px-3 py-2.5 text-sm font-medium text-muted"
     role="status">
    <%= inline_icon :clock, classes: "size-5 shrink-0" %>
    <%= t(".vacation_notice") %>
  </p>
<% end %>

<%# --- tabs --------------------------------------------------------------- %>
<nav aria-label="<%= t(".tabs_label") %>" class="mt-6 flex gap-1 border-b border-border">
  <% StoresController::TABS.each do |tab| %>
    <% current = tab == @tab %>
    <%= link_to t(".tabs.#{tab}"), store_path(store, tab: tab),
          class: "min-h-11 inline-flex items-center border-b-2 px-3 text-sm font-semibold #{current ? "border-primary text-primary" : "border-transparent text-muted hover:text-text"}",
          "aria-current": ("page" if current) %>
  <% end %>
</nav>

<% if @tab == "about" %>
  <section class="mt-5 max-w-2xl">
    <h2 class="text-base font-semibold"><%= t(".about_title") %></h2>
    <% if store.description.present? %>
      <p class="mt-2 whitespace-pre-line text-sm leading-6 text-text"><%= store.description %></p>
    <% else %>
      <p class="mt-2 text-sm text-muted"><%= t(".about_empty") %></p>
    <% end %>

    <% facts = [
         [ t(".about_type"), t("stores.types.#{store.store_type}") ],
         [ t(".about_member_since"), l(store.created_at.to_date, format: :long) ],
         [ t(".about_verified"), store.verified? ? t("helpers.boolean.yes") : t("helpers.boolean.no") ]
       ]
       facts << [ t(".about_vat"), store.vat_number ] if store.vat_number.present? %>
    <dl class="mt-5 grid gap-x-8 sm:grid-cols-2">
      <% facts.each do |label, value| %>
        <div class="flex items-baseline justify-between gap-4 border-b border-border py-2 text-sm">
          <dt class="text-muted"><%= label %></dt>
          <dd class="text-right font-medium"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </section>
<% elsif @tab == "reviews" %>
  <section class="mt-5">
    <h2 class="text-base font-semibold"><%= t(".reviews_title") %></h2>

    <% if @reviews.empty? %>
      <p class="mt-3 rounded-lg border border-dashed border-border bg-surface-muted px-4 py-8 text-center text-sm text-muted">
        <%= t(".reviews_empty") %>
      </p>
    <% else %>
      <ul class="mt-3 space-y-3">
        <% @reviews.each do |review| %>
          <li class="rounded-lg border border-border p-4">
            <div class="flex items-center justify-between gap-3">
              <p class="truncate text-sm font-semibold"><%= review.reviewer.display_name %></p>
              <time class="shrink-0 text-xs text-muted" datetime="<%= review.created_at.iso8601 %>">
                <%= l(review.created_at.to_date, format: :long) %>
              </time>
            </div>
            <div class="mt-1"><%= stars(review.rating) %></div>
            <% if review.body.present? %>
              <p class="mt-2 text-sm leading-6"><%= review.body %></p>
            <% end %>
          </li>
        <% end %>
      </ul>

      <% if @reviews_pagy.pages > 1 %>
        <nav class="mt-6 flex justify-center"><%= results_pagination(@reviews_pagy) %></nav>
      <% end %>
    <% end %>
  </section>
<% else %>
  <div class="mt-5">
    <%= render "listings/browse", result: @result %>
  </div>
<% end %>
